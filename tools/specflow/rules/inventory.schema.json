{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "specflow rule inventory",
  "description": "Each behavior rule's sources, file, kind, and check; no rule text. check_rules.py tests the version, a missing check, and every cross-reference itself.",
  "type": "object",
  "required": ["schemaVersion", "plans", "rules"],
  "properties": {
    "schemaVersion": {"type": "integer"},
    "plans": {"type": "object"},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "file", "kind", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^SR-[A-Z]{3}-[0-9]{3}(?!\\n)$"},
        "file": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["structural", "behavioral"]},
        "check": {
          "type": "string",
          "pattern": "^(validator:[a-z0-9]+(-[a-z0-9]+)*|evals/SR-[A-Z]{3}-[0-9]{3}[.]json|test:[^:]+::[A-Za-z_][A-Za-z0-9_]*)(?!\\n)$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([A-Z]:[A-Z]+-[A-Z0-9]+|D:[0-9]{4}-[0-9]{2}-[0-9]{2}#[0-9]+|R:[A-Z]+-[0-9]{3}[.][0-9]+)(?!\\n)$"
          }
        },
        "criteria": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}[.][0-9]+(?!\\n)$"}
        }
      }
    }
  }
}
