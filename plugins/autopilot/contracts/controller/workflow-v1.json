{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buvis.github.io/agent-plugins/autopilot/contracts/controller/workflow-v1.json",
  "title": "AP00018 controller kernel v1",
  "description": "Closed kernel durable state. $defs/request describes every implemented operation's payload; $defs/response describes core apply results only; contract and snapshot have separate projections. UTF-8 formats are asserted by the configuration tests and must also be enforced by the runtime. Reserved operation names declare unavailable capabilities, not payload implementations.",
  "$ref": "#/$defs/state",
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "utf8-256"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "absolute_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "format": "utf8-1048576",
      "pattern": "^/"
    },
    "mode": {
      "enum": [
        "manual",
        "supervised"
      ]
    },
    "owner": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/identity"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "native_session_id": {
          "$ref": "#/$defs/identity"
        },
        "lease_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        }
      },
      "required": [
        "actor_id",
        "mode",
        "native_session_id",
        "lease_epoch"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/identity"
        },
        "project_id": {
          "$ref": "#/$defs/digest"
        },
        "workflow_id": {
          "$ref": "#/$defs/identity"
        },
        "role": {
          "enum": [
            "operator",
            "owner"
          ]
        },
        "lease_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "native_session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "secret_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "actor_id",
        "project_id",
        "workflow_id",
        "role",
        "lease_epoch",
        "native_session_id",
        "secret_digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "owner"
              }
            }
          },
          "then": {
            "properties": {
              "native_session_id": {
                "$ref": "#/$defs/identity"
              }
            }
          },
          "else": {
            "properties": {
              "native_session_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "task_row": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "subject": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "aborted"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "attempts": {
          "type": "array"
        },
        "start_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        }
      },
      "required": [
        "id",
        "subject",
        "status",
        "depends_on",
        "attempts"
      ],
      "additionalProperties": false
    },
    "job_row": {
      "type": "object",
      "properties": {
        "spec": {
          "$ref": "#/$defs/stored_job_spec"
        },
        "claimed_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim_epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonnegative_integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_fact": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "spec",
        "claimed_by",
        "claim_epoch",
        "exit_fact"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "batch": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "completed_prds": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                },
                "parks_consecutive": {
                  "$ref": "#/$defs/nonnegative_integer"
                }
              },
              "required": [
                "completed_prds",
                "parks_consecutive"
              ],
              "additionalProperties": false
            }
          ]
        },
        "work": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "prd": {
                  "$ref": "#/$defs/text"
                },
                "source": {
                  "enum": [
                    "wip",
                    "backlog"
                  ]
                },
                "entered_at": {
                  "$ref": "#/$defs/text"
                },
                "phase": {
                  "$ref": "#/$defs/text"
                },
                "completed_phases": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                },
                "lane": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/text"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lane_reason": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/text"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rework_cap": {
                  "$ref": "#/$defs/nonnegative_integer"
                },
                "start_commit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "task_tier": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/text"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "plan_expansion": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/text"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "prd",
                "source",
                "entered_at",
                "phase",
                "completed_phases",
                "lane",
                "lane_reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task_row"
          },
          "maxItems": 256
        },
        "review": {
          "type": "object",
          "properties": {
            "cap": {
              "type": "integer",
              "const": 2
            }
          },
          "required": [
            "cap"
          ],
          "additionalProperties": false
        },
        "recovery": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "$ref": "#/$defs/text"
                },
                "boundary": {
                  "$ref": "#/$defs/text"
                }
              },
              "required": [
                "op",
                "boundary"
              ],
              "additionalProperties": false
            }
          ]
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job_row"
          },
          "maxItems": 256
        },
        "pause": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "site": {
                  "$ref": "#/$defs/text"
                },
                "detail": {
                  "$ref": "#/$defs/text"
                }
              },
              "required": [
                "site",
                "detail"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "batch",
        "work",
        "tasks",
        "review",
        "recovery",
        "jobs"
      ],
      "additionalProperties": false,
      "default": {
        "batch": null,
        "work": null,
        "tasks": [],
        "review": {
          "cap": 2
        },
        "recovery": null,
        "jobs": []
      }
    },
    "open_payload": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "acquire_payload": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "native_session_id": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "mode",
        "native_session_id"
      ],
      "additionalProperties": false
    },
    "release_payload": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "recover_payload": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "format": "utf8-4096"
        },
        "reconciled_job_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "reason",
        "reconciled_job_ids"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "format": "utf8-1048576"
    },
    "enter_payload": {
      "type": "object",
      "properties": {
        "prds": {
          "type": "array"
        }
      },
      "required": [
        "prds"
      ],
      "additionalProperties": false
    },
    "handoff_payload": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string"
        },
        "next_phase": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        }
      },
      "required": [
        "phase",
        "next_phase",
        "outcome"
      ],
      "additionalProperties": false
    },
    "move_payload": {
      "type": "object",
      "properties": {
        "prd": {
          "$ref": "#/$defs/identity"
        },
        "site": {
          "$ref": "#/$defs/text"
        },
        "detail": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "prd",
        "site",
        "detail"
      ],
      "additionalProperties": false
    },
    "defer_payload": {
      "type": "object",
      "properties": {
        "prd": {
          "$ref": "#/$defs/identity"
        },
        "record": {
          "type": "object"
        }
      },
      "required": [
        "prd",
        "record"
      ],
      "additionalProperties": false
    },
    "complete_payload": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "planned_task": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "subject": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "aborted"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "required": [
        "id",
        "subject",
        "status",
        "depends_on"
      ],
      "additionalProperties": false
    },
    "task_replace_payload": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/planned_task"
          }
        },
        "allow_expansion": {
          "type": "boolean"
        }
      },
      "required": [
        "tasks",
        "allow_expansion"
      ],
      "additionalProperties": false
    },
    "task_start_payload": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "task_finish_payload": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "outcome": {}
      },
      "required": [
        "id",
        "outcome"
      ],
      "additionalProperties": false
    },
    "task_attempt_payload": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "implementor": {},
        "outcome": {}
      },
      "required": [
        "id",
        "implementor",
        "outcome"
      ],
      "additionalProperties": false
    },
    "route_payload": {
      "type": "object",
      "properties": {
        "prd_frontmatter": {
          "type": "object"
        }
      },
      "required": [
        "prd_frontmatter"
      ],
      "additionalProperties": false
    },
    "bind_payload": {
      "type": "object",
      "properties": {
        "lane": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "lane",
        "reason"
      ],
      "additionalProperties": false
    },
    "job_spec": {
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "#/$defs/identity"
        },
        "role": {
          "$ref": "#/$defs/text"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "input_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "isolation": {
          "$ref": "#/$defs/text"
        },
        "tier": {
          "$ref": "#/$defs/text"
        },
        "effort": {
          "$ref": "#/$defs/text"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "resource_digest": {
          "$ref": "#/$defs/digest"
        },
        "permitted_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        }
      },
      "required": [
        "job_id",
        "role",
        "depends_on",
        "input_digests",
        "isolation",
        "tier",
        "effort",
        "source_digest",
        "resource_digest",
        "permitted_operations"
      ],
      "additionalProperties": false
    },
    "stored_job_spec": {
      "description": "A committed job row's spec. A row written before the metadata keys existed still validates, so source_digest, resource_digest and permitted_operations stay optional here while job_spec requires them from a caller.",
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "#/$defs/identity"
        },
        "role": {
          "$ref": "#/$defs/text"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "input_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "isolation": {
          "$ref": "#/$defs/text"
        },
        "tier": {
          "$ref": "#/$defs/text"
        },
        "effort": {
          "$ref": "#/$defs/text"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "resource_digest": {
          "$ref": "#/$defs/digest"
        },
        "permitted_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        }
      },
      "required": [
        "job_id",
        "role",
        "depends_on",
        "input_digests",
        "isolation",
        "tier",
        "effort"
      ],
      "additionalProperties": false
    },
    "job_plan_payload": {
      "type": "object",
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job_spec"
          }
        }
      },
      "required": [
        "jobs"
      ],
      "additionalProperties": false
    },
    "job_claim_payload": {
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "job_id"
      ],
      "additionalProperties": false
    },
    "job_exit_payload": {
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "#/$defs/identity"
        },
        "exit_fact": {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/text"
            },
            "native_session_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/identity"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "outcome",
            "native_session_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "job_id",
        "exit_fact"
      ],
      "additionalProperties": false
    },
    "open_result": {
      "type": "object",
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/identity"
        },
        "actor_id": {
          "$ref": "#/$defs/identity"
        },
        "actor_file": {
          "$ref": "#/$defs/absolute_path"
        },
        "lease_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        }
      },
      "required": [
        "workflow_id",
        "actor_id",
        "actor_file",
        "lease_epoch"
      ],
      "additionalProperties": false
    },
    "acquire_result": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/identity"
        },
        "actor_file": {
          "$ref": "#/$defs/absolute_path"
        },
        "lease_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "operator_actor_file": {
          "$ref": "#/$defs/absolute_path"
        }
      },
      "required": [
        "actor_id",
        "actor_file",
        "lease_epoch",
        "operator_actor_file"
      ],
      "additionalProperties": false
    },
    "rotation_result": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/identity"
        },
        "operator_actor_file": {
          "$ref": "#/$defs/absolute_path"
        },
        "lease_epoch": {
          "$ref": "#/$defs/nonnegative_integer"
        }
      },
      "required": [
        "actor_id",
        "operator_actor_file",
        "lease_epoch"
      ],
      "additionalProperties": false
    },
    "core_result": {
      "oneOf": [
        {
          "$ref": "#/$defs/open_result"
        },
        {
          "$ref": "#/$defs/acquire_result"
        },
        {
          "$ref": "#/$defs/rotation_result"
        }
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/core_result"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "enum": [
            null,
            "invalid_request",
            "incompatible_contract",
            "revision_conflict",
            "wrong_binding",
            "missing_capability",
            "rejected_evidence",
            "recovery_required"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "revision",
        "result",
        "error_code",
        "retryable"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/core_result"
              },
              "error_code": {
                "type": "null"
              },
              "retryable": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "type": "null"
              },
              "error_code": {
                "enum": [
                  "invalid_request",
                  "incompatible_contract",
                  "revision_conflict",
                  "wrong_binding",
                  "missing_capability",
                  "rejected_evidence",
                  "recovery_required"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error_code": {
                "const": "revision_conflict"
              }
            }
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "retryable": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "core_response": {
      "allOf": [
        {
          "$ref": "#/$defs/response"
        },
        {
          "properties": {
            "ok": {
              "const": true
            }
          }
        }
      ],
      "x-max-serialized-utf8-bytes": 65536
    },
    "receipt": {
      "type": "object",
      "properties": {
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "authorizing_actor": {
          "$ref": "#/$defs/actor"
        },
        "response": {
          "$ref": "#/$defs/core_response"
        }
      },
      "required": [
        "request_digest",
        "authorizing_actor",
        "response"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "revision": {
          "$ref": "#/$defs/nonnegative_integer"
