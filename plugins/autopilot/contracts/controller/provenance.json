      "topic": "schema",
      "source": "top-level State has batch/work/tasks/review/control/recovery and review cap 3",
      "target": "identity/lease/actors/receipts and frozen workflow reserves, review cap 2; source fields individually deferred; no process identity/PID/launcher/heartbeat/resource/TUI authority"
    },
    {
      "topic": "restore",
      "source": "precondition(current) runs before decoding backup; any valid backup is republished at current revision + 1",
      "target": "after decoding backup under same exclusive lock, require identical lease_epoch/owner/actors/receipts and absent credential-intent.json, else BackupError before either pair file changes; offline forensic primitive only"
    },
    {
