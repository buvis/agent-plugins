  "preserved_invariants": [
    "Reject unknown/missing owned fields and bool integers; validate before deep copy.",
    "Strict duplicate-key/nonfinite/depth/integer/UTF-8/serialized-byte bounds.",
    "StateStore.read shared lock; initialize/transaction/restore exclusive flock sidecar.",
    "CAS inside exclusive lock; isolated mutator copy; revision advances once.",
    "O_NOFOLLOW, inode consistency, regular single-link artifacts and bounded reads.",
    "File fsync before publication; directory fsync after publication; six source boundaries.",
    "Create-only initialization including race checks; one exact prior-state backup; exact state/backup repair on failed publication guards.",
    "Current state must decode and validate before backup restore; unsupported directory fsync raises explicitly.",
    "Directory descriptors and ancestor inode snapshots/rechecks survive layout adaptation."
  ],
  "deliberate_divergences": [
