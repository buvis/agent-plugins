{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AUTOPILOT_PLUGIN_ROOT}/scripts/autopilot.py\" --hook codex --event PreToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AUTOPILOT_PLUGIN_ROOT}/scripts/autopilot.py\" --hook codex --event PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AUTOPILOT_PLUGIN_ROOT}/scripts/autopilot.py\" --hook codex --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AUTOPILOT_PLUGIN_ROOT}/scripts/autopilot.py\" --hook codex --event Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AUTOPILOT_PLUGIN_ROOT}/scripts/autopilot.py\" --hook codex --event SessionStart",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
