{
  "schemaVersion": 1,
  "rule": "SR-REQ-050",
  "session": "shared-dialogue",
  "assertions": [
    {
      "kind": "file_matches",
      "path": ".kiro/specs/00001-import-retries/requirements.md",
      "pattern": "(?m)^Source: "
    },
    {
      "kind": "validation_passes",
      "check": "requirement-source"
    },
    {
      "kind": "file_lacks",
      "path": ".kiro/specs/00001-import-retries/requirements.md",
      "pattern": "(?i)parquet"
    }
  ]
}
