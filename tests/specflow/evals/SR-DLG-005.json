{
  "schemaVersion": 1,
  "rule": "SR-DLG-005",
  "session": "shared-dialogue",
  "assertions": [
    {
      "kind": "file_matches",
      "path": ".kiro/specflow/intake/processed/00001-import-retries/qa-log.md",
      "pattern": "(?m)^## Q\\d+ - "
    },
    {
      "kind": "file_matches",
      "path": ".kiro/specflow/intake/processed/00001-import-retries/qa-log.md",
      "pattern": "replaces Q\\d+"
    },
    {
      "kind": "file_matches",
      "path": ".kiro/specflow/intake/processed/00001-import-retries/qa-log.md",
      "pattern": "Retry a skipped row once, the next night"
    },
    {
      "kind": "file_matches",
      "path": ".kiro/specflow/intake/processed/00001-import-retries/qa-log.md",
      "pattern": "retry a skipped row twice, not once"
    }
  ]
}
