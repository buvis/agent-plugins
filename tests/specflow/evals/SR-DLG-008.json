{
  "schemaVersion": 1,
  "rule": "SR-DLG-008",
  "session": "shared-dialogue",
  "assertions": [
    {
      "kind": "file_matches",
      "path": ".kiro/specflow/intake/processed/00001-import-retries/qa-log.md",
      "pattern": "I cannot confirm the budget until the pilot"
    },
    {
      "kind": "file_matches",
      "path": ".kiro/specflow/intake/processed/00001-import-retries/qa-log.md",
      "pattern": "(?i)Follow-up:.*Parquet"
    },
    {
      "kind": "file_matches",
      "path": ".kiro/specs/00001-import-retries/requirements.md",
      "pattern": "(?s)## Unresolved questions(?:(?!\\n## ).)*(?i:budget)"
    },
    {
      "kind": "file_matches",
      "path": ".kiro/specs/00001-import-retries/requirements.md",
      "pattern": "(?s)## Unresolved questions(?:(?!\\n## ).)*(?i:on-call|pag)"
    },
    {
      "kind": "file_lacks",
      "path": ".kiro/specs/00001-import-retries/requirements.md",
      "pattern": "(?s)## Unresolved questions(?:(?!\\n## ).)*(?i:parquet)"
    },
    {
      "kind": "rubric",
      "rubric": "Is 'Run the retry nightly for now.' either clarified with a question or kept as uncertain, never read as a settled choice from the words 'for now'?"
    }
  ]
}
