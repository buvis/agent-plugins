{
  "schemaVersion": 1,
  "rule": "SR-DSN-022",
  "session": "design-reuse",
  "assertions": [
    {
      "kind": "file_exists",
      "path": ".kiro/specs/00001-retry-uploads/design.md"
    },
    {
      "kind": "file_matches",
      "path": ".kiro/specs/00001-retry-uploads/design.md",
      "pattern": "^# Design: "
    },
    {
      "kind": "rubric",
      "rubric": "Is the design written as design.md in the spec folder from templates/design.md, with no design file written anywhere else?"
    }
  ]
}
