@@ -57,6 +57,19 @@ def digest(data: bytes) -> str:
     return hashlib.sha256(data).hexdigest()
 
 
+# Literal project-file examples and a suffix used to describe runner naming.
+SCRIPT_EXAMPLES = {"a.py", "b.py", "src/x.py", "src/cli.py", "src/export.py",
+                   "path/to/test_file.py", "-run.sh"}
+SCRIPT_REFERENCE = re.compile(r"[\w./~${}<>-]+\.(?:py|sh)\b")
+
+
+def script_dependencies(text: str) -> set[tuple[int, str]]:
+    return {(number, match[0])
+            for number, line in enumerate(text.splitlines(), 1)
+            for match in SCRIPT_REFERENCE.finditer(line)
+            if match[0] not in SCRIPT_EXAMPLES}
+
+
 class TargetPackageTest(unittest.TestCase):
