@@ -346,6 +362,72 @@ class TargetPackageTest(unittest.TestCase):
                 else:
                     self.assertRegex(edge["runtime_rule"], r"(?i)(must not|never).*(runtime|content)")
 
+    def assert_script_closure(self, edges: list[dict]) -> None:
+        expected = set()
+        for asset in self.inventory["assets"]:
+            source = asset["source_path"]
+            if not source.startswith(("skills/", "agents/")) or not source.endswith(".md"):
+                continue
+            relative = ("references/personas/" + source.removeprefix("agents/")
+                        if source.startswith("agents/") else source)
+            data = (self.package / relative).read_bytes()
+            if source.endswith("/SKILL.md"):
+                end = data.index(b"\n---\n", 4) + len(b"\n---\n")
+                data = data[:end] + data[end + GATE_SIZE:]
+            self.assertEqual(digest(data), asset["blob_sha256"], source)
+            expected.update((source, line, reference)
+                            for line, reference in script_dependencies(data.decode()))
+        indexed = {(e.get("source_path"), e.get("source_line"), e["reference"]): e
+                   for e in edges}
+        self.assertFalse(expected - indexed.keys(), sorted(expected - indexed.keys()))
+        for identity in expected:
+            edge = indexed[identity]
+            self.assertEqual(edge["kind"], "external-capability")
+            self.assertEqual(edge["status"], "unavailable")
+            self.assertEqual(edge["capability"], identity[2])
+            self.assertRegex(edge["failure_rule"], r"(?i)refuse.*before execution")
+            self.assertIn("no source checkout fallback", edge["failure_rule"])
+            gate = self.target / edge["gate_entry_point"]
+            self.assertTrue(gate.resolve().is_relative_to(self.package.resolve()))
+            self.assertTrue(gate.is_file())
+            self.assertEqual(gate.name, "SKILL.md")
+            gate_data = gate.read_bytes()
+            start = gate_data.index(b"\n---\n", 4) + len(b"\n---\n")
+            self.assertEqual(digest(gate_data[start:start + GATE_SIZE]), GATE_SHA)
+            self.assertNotIn("destination_path", edge)
+        # A classification or path escape must also fail for legacy helpers.
+        for edge in edges:
+            if edge["kind"] == "external-capability" and "destination_path" in edge:
+                path = self.target / edge["destination_path"]
+                self.assertTrue(path.resolve().is_relative_to(self.package.resolve()))
+
+    def test_named_helpers_have_source_anchored_unavailable_edges(self) -> None:
+        names = {"consolidate_findings.py", "compute_mech_facts.py", "render_prompt.py",
+                 "record_dispatch.py", "detect_tautological_tests.py", "check_review_file.py",
+                 "await_reviewer_outputs.py", "fast_track_plan.py", "card.py", "fablectl.py",
+                 "parse_review.py", "diagnose_task.py"}
+        for name in names:
+            with self.subTest(helper=name):
+                edges = [e for e in self.mapping["resource_edges"]
+                         if PurePosixPath(e["reference"]).name == name
+                         and e.get("source_path")]
+                self.assertTrue(edges)
+                self.assertTrue(all(e["kind"] == "external-capability" and
+                                    e["status"] == "unavailable" for e in edges))
+
+    def test_derived_closure_rejects_omissions_misclassification_and_escape(self) -> None:
+        edges = self.mapping["resource_edges"]
+        selected = next(e for e in edges if e.get("source_path") and
+                        PurePosixPath(e["reference"]).name == "diagnose_task.py")
+        with self.assertRaises(AssertionError):
+            self.assert_script_closure([e for e in edges if e is not selected])
+        for change in ({"kind": "informational-provenance"},
+                       {"gate_entry_point": "../outside/SKILL.md"},
+                       {"destination_path": "../outside/helper.py"}):
+            with self.subTest(change=change), self.assertRaises(AssertionError):
+                self.assert_script_closure([dict(e, **change) if e is selected else e
+                                            for e in edges])
+
     def test_public_validator_accepts_contained_links_and_rejects_external_helpers(self) -> None:
         baseline = self.validator()
         self.assertEqual(baseline.returncode, 0, baseline.stdout + baseline.stderr)
